# Copy this file to .env and fill in local values.
# Do not commit .env.

HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=replace_with_home_assistant_long_lived_access_token

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

CHROMA_DIR=data/chroma
CHROMA_COLLECTION=home_assistant_history

# Comma-separated entity ids. Leave empty to ingest all returned history.
# Examples:
# HA_ENTITY_IDS=sensor.workstation_power,sensor.tv_power,binary_sensor.motion_living_room
HA_ENTITY_IDS=

